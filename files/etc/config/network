config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd21:13c0:107e::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.3.2'
	option netmask '255.255.255.0'
	option gateway '192.168.3.1'
	# Resolver box sendiri = AdGuardHome lokal (port 53, redirect=none).
	# Sebelumnya 9.9.9.9: query health-check/tooling di box melewati AGH.
	# AGH tetap resolve lewat upstream sendiri (8.8.8.8/9.9.9.9/DoH) -> tidak ada loop.
	list dns '192.168.3.2'
	option delegate '0'
